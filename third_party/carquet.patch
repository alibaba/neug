+/* ============================================================================
+ * Callback I/O
+ * ============================================================================
+ *
+ * Callback streams let embedders route Parquet I/O through their own VFS.
+ * Carquet copies the callback table and takes ownership of the context once an
+ * open call is made. A reader invokes close exactly once, including when
+ * opening fails. Callbacks must not call back into the same reader.
+ */
+
+typedef carquet_status_t (*carquet_input_get_size_fn)(
+    void* context, int64_t* size);
+typedef carquet_status_t (*carquet_input_read_at_fn)(
+    void* context, int64_t offset, void* buffer, size_t size,
+    size_t* bytes_read);
+typedef void (*carquet_input_close_fn)(void* context);
+
+typedef struct carquet_input_stream {
+    void* context;
+    carquet_input_get_size_fn get_size;
+    carquet_input_read_at_fn read_at;
+    carquet_input_close_fn close;
+} carquet_input_stream_t;
